{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "InvoiceProcessor": "Server=localhost,1433;Database=InvoiceProcessor;User Id=sa;TrustServerCertificate=True"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "FileStorage": {
    "RootPath": "uploads"
  },
  "Uploads": {
    "MaxFileSizeMb": 10
  },
  "Llm": {
    "Provider": "Anthropic",
    "Model": "claude-opus-5",
    "MaxTokens": 16000,
    "Pricing": {
      "claude-opus-5": { "InputPerMillion": 5.00, "OutputPerMillion": 25.00 },
      "claude-opus-4-8": { "InputPerMillion": 5.00, "OutputPerMillion": 25.00 },
      "claude-sonnet-5": { "InputPerMillion": 2.00, "OutputPerMillion": 10.00 },
      "claude-haiku-4-5": { "InputPerMillion": 1.00, "OutputPerMillion": 5.00 }
    }
  }
}
