{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Auth": {
    // Short passwords are allowed only here, for the demo accounts; elsewhere the minimum is 10.
    "PasswordMinLength": 4,
    // Demo accounts for local development only; outside Development the first admin comes from Auth:Admin.
    "DemoUsers": [
      { "Email": "admin@example.com", "Password": "1234", "Role": "Admin" },
      { "Email": "reviewer@example.com", "Password": "1234", "Role": "Reviewer" }
    ]
  }
}
