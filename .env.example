# Copy to .env and fill in. .env is git-ignored.

# SQL Server SA password: min 8 chars, with upper, lower, digit and symbol. Avoid ';' (it ends the connection string).
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
MSSQL_PORT=1433

# First admin account, created on the first start. The password needs at least 10 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Anthropic API key for extraction (https://console.anthropic.com). Without it the app runs,
# but every upload fails extraction and can only be retried or rejected.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5

# Port the app is served on: http://localhost:8080
WEB_PORT=8080
